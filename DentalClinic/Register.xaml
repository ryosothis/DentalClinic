<Page x:Class="DentalClinic.Register"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" d:DesignWidth="1300"
      Title="Register" Height="Auto" Width="Auto">

    <Page.Resources>
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#244484"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="#C9DEFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#467EEA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="AuthButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#244484"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A366B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F2444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LinkStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#467EEA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#244484"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для панелей навигации -->
        <Style x:Key="NavPanelStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Page.Resources>

    <Grid VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель -->
        <StackPanel Grid.Column="0" Grid.RowSpan="2" Background="#244484" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Margin="18,26,0,16" VerticalAlignment="Top">
                <TextBlock Text="Квио" Foreground="White" FontWeight="Bold" FontSize="26"/>
                <Image Source="/logo.png" Width="32" Height="32" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="цифровая стоматология" Foreground="White" Margin="18,-20,0,36" FontSize="9"/>

            <StackPanel Margin="18,0,0,0">
                <!-- Главная -->
                <StackPanel x:Name="HomePanel" Style="{StaticResource NavPanelStyle}"
                            MouseLeftButtonDown="HomePanel_MouseLeftButtonDown">
                    <Image Source="/home.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Главная" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- О клинике -->
                <StackPanel x:Name="AboutPanel" Style="{StaticResource NavPanelStyle}"
                            MouseLeftButtonDown="AboutPanel_MouseLeftButtonDown">
                    <Image Source="/info.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="О клинике" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Услуги -->
                <StackPanel x:Name="ServicesPanel" Style="{StaticResource NavPanelStyle}"
                            MouseLeftButtonDown="ServicesPanel_MouseLeftButtonDown">
                    <Image Source="/services.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Услуги" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Цены -->
                <StackPanel x:Name="PricePanel" Style="{StaticResource NavPanelStyle}"
                            MouseLeftButtonDown="PricePanel_MouseLeftButtonDown">
                    <Image Source="/price.png" Width="20" Height="20" Margin="0,5,10,0"/>
                    <TextBlock Text="Цены" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Профиль -->
                <StackPanel x:Name="ProfilePanel" Style="{StaticResource NavPanelStyle}"
                            MouseLeftButtonDown="ProfilePanel_MouseLeftButtonDown">
                    <Image Source="/user.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Профиль" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="-8,350,0,0" HorizontalAlignment="Left">
                <Image Source="/vk.png" Width="20" Height="20" Margin="30,0,0,0"/>
                <Image Source="/whatsapp.png" Width="20" Height="20" Margin="16,0,0,0"/>
                <Image Source="/tg.png" Width="20" Height="20" Margin="16,0,0,0"/>
            </StackPanel>
        </StackPanel>

        <!-- Основной контент -->
        <Border Grid.Column="1" Grid.RowSpan="2"
                Background="#F5F6FA"
                Padding="10"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                MinWidth="500" MinHeight="600">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Border Background="White"
                        Padding="40"
                        Margin="0,70,0,0"
                        BorderBrush="#E1E8FF"
                        BorderThickness="1"
                        CornerRadius="20"
                        Width="Auto"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        MinWidth="400">
                    <StackPanel>
                        <TextBlock Text="Регистрация" 
                                   FontWeight="Bold" FontSize="28" 
                                   Foreground="#244484" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,0,0,25"/>

                        <!-- Имя -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Имя" 
                                       Foreground="#244484" 
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="FirstNameTextBox" 
                                     Style="{StaticResource ModernTextBox}" 
                                     Text=""
                                     ToolTip="Введите ваше имя"/>
                        </StackPanel>

                        <!-- Фамилия -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Фамилия" 
                                       Foreground="#244484" 
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="LastNameTextBox" 
                                     Style="{StaticResource ModernTextBox}" 
                                     Text=""/>
                        </StackPanel>

                        <!-- Отчество -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Отчество" 
                                       Foreground="#244484" 
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="MiddleNameTextBox" 
                                     Style="{StaticResource ModernTextBox}" 
                                     Text=""/>
                        </StackPanel>

                        <!-- Телефон -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Телефон" 
                                       Foreground="#244484" 
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="PhoneTextBox" 
                                     Style="{StaticResource ModernTextBox}" 
                                     Text=""/>
                        </StackPanel>

                        <!-- Email -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Email" 
                                       Foreground="#244484" 
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <TextBox x:Name="EmailTextBox" 
                                     Style="{StaticResource ModernTextBox}" 
                                     Text=""/>
                        </StackPanel>

                        <!-- Дата рождения -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Дата рождения" 
                                       Foreground="#244484" 
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <DatePicker x:Name="BirthDatePicker"
                                        Height="48"
                                        FontSize="16"
                                        VerticalContentAlignment="Center"
                                        BorderBrush="#C9DEFF"
                                        BorderThickness="2"
                                        Background="#FFFFFF"/>
                        </StackPanel>

                        <!-- Пароль -->
                        <StackPanel Margin="0,0,0,12">
                            <TextBlock Text="Пароль" 
                                       Foreground="#244484" 
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <PasswordBox x:Name="PasswordBox"
                                         Background="#FFFFFF"
                                         Foreground="#244484"
                                         FontSize="16"
                                         Padding="16,12"
                                         BorderBrush="#C9DEFF"
                                         BorderThickness="2"
                                         Height="48"
                                         VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Подтверждение пароля -->
                        <StackPanel Margin="0,0,0,20">
                            <TextBlock Text="Подтверждение пароля" 
                                       Foreground="#244484" 
                                       FontWeight="SemiBold"
                                       Margin="0,0,0,6"/>
                            <PasswordBox x:Name="ConfirmPasswordBox"
                                         Background="#FFFFFF"
                                         Foreground="#244484"
                                         FontSize="16"
                                         Padding="16,12"
                                         BorderBrush="#C9DEFF"
                                         BorderThickness="2"
                                         Height="48"
                                         VerticalContentAlignment="Center"/>
                        </StackPanel>

                        <!-- Соглашение -->
                        <CheckBox x:Name="AgreementCheckBox"
                                  Content="Я согласен с условиями использования" 
                                  Foreground="#244484"
                                  FontSize="14"
                                  Margin="0,0,0,20"/>

                        <!-- Кнопка регистрации -->
                        <Button x:Name="RegisterButton"
                                Content="Зарегистрироваться" 
                                Style="{StaticResource AuthButtonStyle}"
                                Margin="0,0,0,15"/>

                        <!-- Ссылка на вход -->
                        <StackPanel Orientation="Horizontal" 
                                    HorizontalAlignment="Center">
                            <TextBlock Text="Уже есть аккаунт? " 
                                       Foreground="#828CA0"
                                       FontSize="14"/>
                            <TextBlock x:Name="LoginLink"
                                       Text="Войти" 
                                       Style="{StaticResource LinkStyle}"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>