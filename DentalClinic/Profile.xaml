<Page x:Class="DentalClinic.Profile"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      Title="Profile"  
      Height="Auto" 
      Width="Auto"
      MinHeight="600"
      MinWidth="900">

    <Page.Resources>
        <Style x:Key="ProfileTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#244484"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="MinWidth" Value="150"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="Background" Value="#F8FBFF"/>
                    <Setter Property="BorderBrush" Value="#467EEA"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
                <Trigger Property="IsReadOnly" Value="False">
                    <Setter Property="Background" Value="#F8FBFF"/>
                    <Setter Property="BorderBrush" Value="#467EEA"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="EditButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#E1E8FF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="MedicalCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E1E8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="MinWidth" Value="250"/>
        </Style>

        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#E1E8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="MinWidth" Value="300"/>
        </Style>

        <Style x:Key="AuthButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#244484"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A366B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F2444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="LogoutButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#FF6B6B"/>
            <Setter Property="BorderBrush" Value="#FF6B6B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="15,8"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#FFF5F5"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#FFE8E8"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" MinWidth="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Background="#244484">
            <StackPanel Orientation="Horizontal" Margin="18,26,0,16" VerticalAlignment="Top">
                <TextBlock Text="Квио" Foreground="White" FontWeight="Bold" FontSize="26"/>
                <Image Source="/logo.png" Width="32" Height="32" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="цифровая стоматология" Foreground="White" 
                       Margin="18,-20,0,36" FontSize="9"/>
            <StackPanel Margin="18,0,0,0">
                <StackPanel x:Name="HomePanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="HomePanel_MouseLeftButtonDown">
                    <Image Source="/home.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Главная" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="AboutPanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="AboutPanel_MouseLeftButtonDown">
                    <Image Source="/info.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="О клинике" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="ServicesPanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="ServicesPanel_MouseLeftButtonDown">
                    <Image Source="/services.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Услуги" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="PricePanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="PricePanel_MouseLeftButtonDown">
                    <Image Source="/price.png" Width="20" Height="20" Margin="0,5,10,0"/>
                    <TextBlock Text="Цены" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="ProfilePanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="ProfilePanel_MouseLeftButtonDown">
                    <Image Source="/user.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Профиль" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="18,20,0,20" VerticalAlignment="Bottom">
                <Image Source="/vk.png" Width="20" Height="20" Margin="0,0,10,0"/>
                <Image Source="/whatsapp.png" Width="20" Height="20" Margin="0,0,10,0"/>
                <Image Source="/tg.png" Width="20" Height="20"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Column="1" Background="#F5F6FA">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel>
                    <ProgressBar x:Name="ProgressBar" 
                                 Height="4" 
                                 Margin="20,20,20,0" 
                                 Visibility="Collapsed"
                                 IsIndeterminate="True"
                                 Foreground="#467EEA"/>

                    <StackPanel x:Name="RoleButtonsPanel" 
                                Orientation="Horizontal" 
                                HorizontalAlignment="Right"
                                Margin="20,20,20,0"
                                Visibility="Collapsed">

                        <Button x:Name="AdminPanelButton"
                                Content="Админ-панель"
                                Style="{StaticResource AuthButtonStyle}"
                                Margin="0,0,10,0"
                                Click="AdminPanelButton_Click"
                                Visibility="Collapsed"/>

                        <Button x:Name="DoctorAppointmentsButton"
                                Content="Мои записи на сегодня"
                                Style="{StaticResource AuthButtonStyle}"
                                Click="DoctorAppointmentsButton_Click"
                                Visibility="Collapsed"/>

                        <Button x:Name="LogoutButton"
                                Content="Выйти"
                                Style="{StaticResource LogoutButtonStyle}"
                                Click="LogoutButton_Click"/>
                    </StackPanel>

                    <StackPanel x:Name="MainContent" Margin="20" MinWidth="700">
                        <TextBlock Text="Профиль" 
                                   FontWeight="Bold" 
                                   FontSize="28" 
                                   Foreground="#244484" 
                                   Margin="0,0,0,20"/>

                        <TextBlock x:Name="RoleTextBlock"
                                   Text="Роль: Загрузка..."
                                   FontSize="14"
                                   Foreground="#828CA0"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,10"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="350" MaxWidth="450"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Border Style="{StaticResource SectionStyle}">
                                    <StackPanel>
                                        <StackPanel HorizontalAlignment="Center" Margin="0,0,0,20">
                                            <Border Width="100" Height="100" 
                                                    Background="#E1E8FF" 
                                                    CornerRadius="50"
                                                    BorderBrush="#C9DEFF"
                                                    BorderThickness="3"
                                                    Margin="0,0,0,15">
                                                <Image Source="/avatar.png" 
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center"/>
                                            </Border>

                                            <StackPanel HorizontalAlignment="Center">
                                                <TextBox x:Name="FullNameTextBox"
                                                         Style="{StaticResource ProfileTextBox}" 
                                                         Text="Загрузка..."
                                                         FontWeight="Bold" 
                                                         FontSize="18"
                                                         TextAlignment="Center"
                                                         BorderThickness="0"
                                                         Background="Transparent"
                                                         TextWrapping="Wrap"/>
                                                <Button x:Name="EditNameButton"
                                                        Style="{StaticResource EditButtonStyle}"
                                                        HorizontalAlignment="Center"
                                                        Margin="0,-8,0,0"
                                                        ToolTip="Редактировать ФИО"
                                                        Click="EditNameButton_Click">
                                                    <Image Source="/edit.png" Width="14" Height="14"/>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>

                                        <StackPanel Margin="0,0,0,15">
                                            <TextBlock Text="Дата рождения" 
                                                       Foreground="#828CA0" 
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,5"/>
                                            <Grid>
                                                <TextBox x:Name="BirthDateTextBox"
                                                         Style="{StaticResource ProfileTextBox}" 
                                                         Text="Загрузка..."
                                                         FontSize="14"
                                                         FontWeight="SemiBold"/>
                                                <Button x:Name="EditBirthDateButton"
                                                        Style="{StaticResource EditButtonStyle}"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Margin="0,0,10,0"
                                                        ToolTip="Редактировать дату рождения"
                                                        Click="EditBirthDateButton_Click">
                                                    <Image Source="/edit.png" Width="12" Height="12"/>
                                                </Button>
                                            </Grid>
                                        </StackPanel>

                                        <StackPanel Margin="0,20,0,0">
                                            <TextBlock Text="Контактная информация" 
                                                       Foreground="#244484" 
                                                       FontSize="14"
                                                       FontWeight="Bold"
                                                       Margin="0,0,0,12"/>

                                            <StackPanel Margin="0,0,0,12">
                                                <TextBlock Text="Email" 
                                                           Foreground="#828CA0" 
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,5"/>
                                                <Grid>
                                                    <TextBox x:Name="EmailTextBox"
                                                             Style="{StaticResource ProfileTextBox}" 
                                                             Text="Загрузка..."
                                                             FontSize="14"/>
                                                    <Button x:Name="EditEmailButton"
                                                            Style="{StaticResource EditButtonStyle}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,10,0"
                                                            ToolTip="Редактировать email"
                                                            Click="EditEmailButton_Click">
                                                        <Image Source="/edit.png" Width="12" Height="12"/>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>

                                            <StackPanel Margin="0,0,0,10">
                                                <TextBlock Text="Телефон" 
                                                           Foreground="#828CA0" 
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Margin="0,0,0,5"/>
                                                <Grid>
                                                    <TextBox x:Name="PhoneTextBox"
                                                             Style="{StaticResource ProfileTextBox}" 
                                                             Text="Загрузка..."
                                                             FontSize="14"/>
                                                    <Button x:Name="EditPhoneButton"
                                                            Style="{StaticResource EditButtonStyle}"
                                                            HorizontalAlignment="Right"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,10,0"
                                                            ToolTip="Редактировать телефон"
                                                            Click="EditPhoneButton_Click">
                                                        <Image Source="/edit.png" Width="12" Height="12"/>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </StackPanel>

                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource SectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="История записей" 
                                                   FontWeight="Bold" 
                                                   FontSize="18" 
                                                   Foreground="#244484" 
                                                   Margin="0,0,0,20"/>

                                        <StackPanel x:Name="MedicalHistoryStackPanel">
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>