<Page x:Class="DentalClinic.Services"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      Title="Services" 
      Height="Auto"
      MinHeight="600"
      MinWidth="800">

    <Page.Resources>
        <!-- Стиль карточки услуги -->
        <Style x:Key="ServiceCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#E1E8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="280"/>
            <Setter Property="Height" Value="180"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FBFF"/>
                    <Setter Property="BorderBrush" Value="#467EEA"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="10" ShadowDepth="2" Color="#40000000" Opacity="0.1"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="NavButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#244484"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A366B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F2444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" MinWidth="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель Квио -->
        <StackPanel Grid.Column="0" Background="#244484">
            <StackPanel Orientation="Horizontal" Margin="18,26,0,16" VerticalAlignment="Top">
                <TextBlock Text="Квио" Foreground="White" FontWeight="Bold" FontSize="26"/>
                <Image Source="/logo.png" Width="32" Height="32" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="цифровая стоматология" Foreground="White" 
                       Margin="18,-20,0,36" FontSize="9"/>
            <StackPanel Margin="18,0,0,0">
                <StackPanel x:Name="HomePanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="HomePanel_MouseLeftButtonDown">
                    <Image Source="/home.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Главная" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="AboutPanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="AboutPanel_MouseLeftButtonDown">
                    <Image Source="/info.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="О клинике" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="ServicesPanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="ServicesPanel_MouseLeftButtonDown">
                    <Image Source="/services.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Услуги" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="PricePanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="PricePanel_MouseLeftButtonDown">
                    <Image Source="/price.png" Width="20" Height="20" Margin="0,5,10,0"/>
                    <TextBlock Text="Цены" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="ProfilePanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="ProfilePanel_MouseLeftButtonDown">
                    <Image Source="/user.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Профиль" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="18,20,0,20" VerticalAlignment="Bottom">
                <Image Source="/vk.png" Width="20" Height="20" Margin="0,0,10,0"/>
                <Image Source="/whatsapp.png" Width="20" Height="20" Margin="0,0,10,0"/>
                <Image Source="/tg.png" Width="20" Height="20"/>
            </StackPanel>
        </StackPanel>

        <!-- Основной контент -->
        <Border Grid.Column="1" Background="#F5F6FA">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20" MinWidth="600">
                    <TextBlock Text="Услуги" 
                               FontWeight="Bold" 
                               FontSize="28" 
                               Foreground="#244484" 
                               Margin="0,0,0,15"/>

                    <TextBlock Text="В нашей клинике мы применяем самые современные цифровые технологии для вашего комфорта и безопасности. Мы предлагаем полный спектр стоматологических услуг — от диагностики и профилактики до эстетической стоматологии и протезирования."
                               FontSize="14" 
                               Margin="0,0,0,30" 
                               Foreground="#828CA0" 
                               TextWrapping="Wrap"
                               MaxWidth="800"/>

                    <!-- Прогресс бар для загрузки -->
                    <ProgressBar x:Name="ProgressBar" 
                                 Height="4" 
                                 Margin="0,0,0,20" 
                                 Visibility="Collapsed"
                                 IsIndeterminate="True"
                                 Foreground="#467EEA"/>

                    <!-- Основной контент -->
                    <StackPanel x:Name="MainContent">
                        <!-- Адаптивная сетка услуг -->
                        <WrapPanel x:Name="ServicesWrapPanel" 
                                   HorizontalAlignment="Center" 
                                   Margin="0,10,0,0">
                            <!-- Карточки услуг будут добавляться динамически -->
                        </WrapPanel>

                        <!-- Кнопка записи -->
                        <Button Content="Записаться на консультацию"
                                Style="{StaticResource NavButtonStyle}"
                                HorizontalAlignment="Center"
                                Margin="0,40,0,0"
                                Padding="25,12"
                                FontSize="16"
                                Click="AppointmentButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>