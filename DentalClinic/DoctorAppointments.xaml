<Page x:Class="DentalClinic.DoctorAppointments"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      Title="Записи врача"  
      Height="Auto" 
      Width="Auto"
      MinHeight="600"
      MinWidth="900">

    <Page.Resources>
        <!-- Стили для карточек записей -->
        <Style x:Key="AppointmentCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E1E8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,15"/>
        </Style>

        <!-- Стиль для кнопки диагноза -->
        <Style x:Key="DiagnosisButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#4CAF50"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#45a049"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#3d8b40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для бейджа статуса -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#E1E8FF"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8,4"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" MinWidth="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель (такая же как в Profile) -->
        <StackPanel Grid.Column="0" Background="#244484">
            <StackPanel Orientation="Horizontal" Margin="18,26,0,16" VerticalAlignment="Top">
                <TextBlock Text="Квио" Foreground="White" FontWeight="Bold" FontSize="26"/>
                <Image Source="/logo.png" Width="32" Height="32" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="цифровая стоматология" Foreground="White" 
                       Margin="18,-20,0,36" FontSize="9"/>
            <StackPanel Margin="18,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="HomePanel_MouseLeftButtonDown">
                    <Image Source="/home.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Главная" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="AboutPanel_MouseLeftButtonDown">
                    <Image Source="/info.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="О клинике" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="ServicesPanel_MouseLeftButtonDown">
                    <Image Source="/services.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Услуги" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="PricePanel_MouseLeftButtonDown">
                    <Image Source="/price.png" Width="20" Height="20" Margin="0,5,10,0"/>
                    <TextBlock Text="Цены" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="ProfilePanel_MouseLeftButtonDown">
                    <Image Source="/user.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Профиль" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="18,20,0,20" VerticalAlignment="Bottom">
                <Image Source="/vk.png" Width="20" Height="20" Margin="0,0,10,0"/>
                <Image Source="/whatsapp.png" Width="20" Height="20" Margin="0,0,10,0"/>
                <Image Source="/tg.png" Width="20" Height="20"/>
            </StackPanel>
        </StackPanel>

        <!-- Основной контент -->
        <Border Grid.Column="1" Background="#F5F6FA">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <!-- Заголовок -->
                    <TextBlock Text="Мои записи на сегодня" 
                               FontWeight="Bold" 
                               FontSize="28" 
                               Foreground="#244484" 
                               Margin="0,0,0,20"/>

                    <!-- Индикатор загрузки -->
                    <ProgressBar x:Name="ProgressBar" 
                                 Height="4" 
                                 Margin="0,0,0,20" 
                                 Visibility="Collapsed"
                                 IsIndeterminate="True"
                                 Foreground="#467EEA"/>

                    <!-- Дата -->
                    <TextBlock x:Name="DateText" 
                               Text="Загрузка..."
                               FontSize="16"
                               Foreground="#828CA0"
                               Margin="0,0,0,20"/>

                    <!-- Список записей -->
                    <StackPanel x:Name="AppointmentsStackPanel">
                        <!-- Записи будут добавляться динамически -->
                    </StackPanel>

                    <!-- Сообщение если нет записей -->
                    <TextBlock x:Name="NoAppointmentsText"
                               Text="На сегодня записей нет"
                               FontSize="16"
                               Foreground="#828CA0"
                               HorizontalAlignment="Center"
                               Margin="0,40,0,0"
                               Visibility="Collapsed"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>