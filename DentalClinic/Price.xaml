<Page x:Class="DentalClinic.Price"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:DentalClinic"
      mc:Ignorable="d"
      Title="Price"
      Height="Auto" 
      Width="Auto"
      MinHeight="600"
      MinWidth="900">

    <Page.Resources>
        <!-- Стиль для красивой кнопки -->
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- Стиль для таблицы цен -->
        <Style x:Key="PriceGridStyle" TargetType="Grid">
            <Setter Property="MinWidth" Value="500"/>
        </Style>

        <!-- Стиль для блока с ценами -->
        <Style x:Key="PriceBlockStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#C9DEFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="18,16,18,24"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
            <Setter Property="MinWidth" Value="600"/>
            <Setter Property="MaxWidth" Value="900"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" MinWidth="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель Квио -->
        <StackPanel Grid.Column="0" Background="#244484">
            <StackPanel Orientation="Horizontal" Margin="18,26,0,16" VerticalAlignment="Top">
                <TextBlock Text="Квио" Foreground="White" FontWeight="Bold" FontSize="26"/>
                <Image Source="/logo.png" Width="32" Height="32" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="цифровая стоматология" Foreground="White" 
                       Margin="18,-20,0,36" FontSize="9"/>
            <StackPanel Margin="18,0,0,0">
                <!-- Меню с иконками -->
                <StackPanel x:Name="HomePanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="HomePanel_MouseLeftButtonDown">
                    <Image Source="/home.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Главная" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="AboutPanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="AboutPanel_MouseLeftButtonDown">
                    <Image Source="/info.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="О клинике" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="ServicesPanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="ServicesPanel_MouseLeftButtonDown">
                    <Image Source="/services.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Услуги" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="PricePanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="PricePanel_MouseLeftButtonDown">
                    <Image Source="/price.png" Width="20" Height="20" Margin="0,5,10,0"/>
                    <TextBlock Text="Цены" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <!-- Добавлен пункт Профиль -->
                <StackPanel x:Name="ProfilePanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="ProfilePanel_MouseLeftButtonDown">
                    <Image Source="/user.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Профиль" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="18,20,0,20" VerticalAlignment="Bottom">
                <Image Source="/vk.png" Width="20" Height="20" Margin="0,0,10,0"/>
                <Image Source="/whatsapp.png" Width="20" Height="20" Margin="0,0,10,0"/>
                <Image Source="/tg.png" Width="20" Height="20"/>
            </StackPanel>
        </StackPanel>

        <!-- Контент с ценами -->
        <Border Grid.Column="1" Background="#F5F6FA">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel Margin="20" MinWidth="700">
                    <TextBlock Text="Цены" 
                               FontWeight="Bold" 
                               FontSize="32" 
                               Foreground="#244484" 
                               Margin="0,0,0,10"/>

                    <TextBlock Text="У нас — честные цены и прозрачные услуги. Вы платите только за то, что нужно для вашей улыбки! Предложим оптимальное решение под ваш бюджет — заботимся о вашем комфорте и экономии."
                               FontSize="14" 
                               Margin="0,0,0,24" 
                               Foreground="#828CA0"
                               TextWrapping="Wrap"
                               MaxWidth="900"/>

                    <!-- Прогресс бар для загрузки -->
                    <ProgressBar x:Name="ProgressBar" 
                                 Height="4" 
                                 Margin="0,0,0,20" 
                                 Visibility="Collapsed"
                                 IsIndeterminate="True"
                                 Foreground="#467EEA"/>

                    <!-- Основной контент -->
                    <StackPanel x:Name="MainContent">
                        <Border Style="{StaticResource PriceBlockStyle}">
                            <StackPanel>
                                <Grid x:Name="ServicesGrid" Style="{StaticResource PriceGridStyle}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <!-- Заголовки -->
                                    <TextBlock Text="Услуга" 
                                               FontWeight="Bold" 
                                               Grid.Row="0" Grid.Column="0" 
                                               FontSize="17" 
                                               Margin="0,0,0,8"/>
                                    <TextBlock Text="Стоимость" 
                                               FontWeight="Bold" 
                                               Grid.Row="0" Grid.Column="1" 
                                               FontSize="17" 
                                               Margin="0,0,0,8"/>
                                </Grid>

                                <Button Content="Записаться на консультацию"
                                        HorizontalAlignment="Center"
                                        Margin="0,28,0,0"
                                        Background="#C9DEFF"
                                        Foreground="#244484"
                                        Padding="26,8"
                                        BorderBrush="#C9DEFF"
                                        Width="320"
                                        FontSize="16"
                                        Click="BookAppointmentButton_Click"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Качественная стоматология доступна каждому."
                                   Foreground="#828CA0" 
                                   FontSize="14" 
                                   Margin="0,0,0,10"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>