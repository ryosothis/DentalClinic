<Page x:Class="DentalClinic.Appointment"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      Title="Appointment"  
      Height="Auto" 
      Width="Auto"
      MinHeight="600"
      MinWidth="900">

    <Page.Resources>
        <!-- Общий стиль для кнопок -->
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <!-- Стиль для кнопки записи -->
        <Style x:Key="AppointmentButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#C9DEFF"/>
            <Setter Property="Foreground" Value="#244484"/>
            <Setter Property="Padding" Value="26,8"/>
            <Setter Property="BorderBrush" Value="#C9DEFF"/>
            <Setter Property="Width" Value="320"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Стиль для текстовых полей -->
        <Style x:Key="AppointmentTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FBFF"/>
            <Setter Property="Foreground" Value="#244484"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#E1E8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#467EEA"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для DatePicker -->
        <Style x:Key="AppointmentDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="#F8FBFF"/>
            <Setter Property="Foreground" Value="#244484"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="BorderBrush" Value="#E1E8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для комбобоксов -->
        <Style x:Key="AppointmentComboBox" TargetType="ComboBox">
            <Setter Property="Background" Value="#F8FBFF"/>
            <Setter Property="Foreground" Value="#244484"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#E1E8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для карточек выбора -->
        <Style x:Key="SelectionCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E1E8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="15"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#467EEA"/>
                    <Setter Property="Background" Value="#F8FBFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для выбранной карточки -->
        <Style x:Key="SelectedCardStyle" TargetType="Border" BasedOn="{StaticResource SelectionCardStyle}">
            <Setter Property="BorderBrush" Value="#467EEA"/>
            <Setter Property="Background" Value="#F0F5FF"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Стиль для секций -->
        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#E1E8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="MinWidth" Value="300"/>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" MinWidth="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель Квио -->
        <StackPanel Grid.Column="0" Background="#244484">
            <StackPanel Orientation="Horizontal" Margin="18,26,0,16" VerticalAlignment="Top">
                <TextBlock Text="Квио" Foreground="White" FontWeight="Bold" FontSize="26"/>
                <Image Source="/logo.png" Width="32" Height="32" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="цифровая стоматология" Foreground="White" 
                       Margin="18,-20,0,36" FontSize="9"/>
            <StackPanel Margin="18,0,0,0">
                <StackPanel x:Name="HomePanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="HomePanel_MouseLeftButtonDown">
                    <Image Source="/home.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Главная" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="AboutPanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="AboutPanel_MouseLeftButtonDown">
                    <Image Source="/info.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="О клинике" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="ServicesPanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="ServicesPanel_MouseLeftButtonDown">
                    <Image Source="/services.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Услуги" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="PricePanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="PricePanel_MouseLeftButtonDown">
                    <Image Source="/price.png" Width="20" Height="20" Margin="0,5,10,0"/>
                    <TextBlock Text="Цены" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel x:Name="ProfilePanel" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="ProfilePanel_MouseLeftButtonDown">
                    <Image Source="/user.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Профиль" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="18,20,0,20" VerticalAlignment="Bottom">
                <Image Source="/vk.png" Width="20" Height="20" Margin="0,0,10,0"/>
                <Image Source="/whatsapp.png" Width="20" Height="20" Margin="0,0,10,0"/>
                <Image Source="/tg.png" Width="20" Height="20"/>
            </StackPanel>
        </StackPanel>

        <!-- Основной контент -->
        <Border Grid.Column="1" Background="#F5F6FA">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <StackPanel Margin="20" MinWidth="700">
                    <!-- Заголовок -->
                    <TextBlock Text="Оформление записи на прием" 
                               FontWeight="Bold" 
                               FontSize="28" 
                               Foreground="#244484" 
                               Margin="0,0,0,20"/>

                    <!-- Прогресс бар для загрузки -->
                    <ProgressBar x:Name="ProgressBar" 
                                 Height="4" 
                                 Margin="0,0,0,20" 
                                 Visibility="Collapsed"
                                 IsIndeterminate="True"
                                 Foreground="#467EEA"/>

                    <!-- Основной контент -->
                    <StackPanel x:Name="MainContent">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" MinWidth="350" MaxWidth="450"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*" MinWidth="300"/>
                            </Grid.ColumnDefinitions>

                            <!-- Левая колонка - выбор услуги и врача -->
                            <StackPanel Grid.Column="0">
                                <!-- Выбор услуги -->
                                <Border Style="{StaticResource SectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Выбор услуги" 
                                                   FontWeight="Bold" 
                                                   FontSize="18" 
                                                   Foreground="#244484" 
                                                   Margin="0,0,0,15"/>

                                        <StackPanel x:Name="ServicesStackPanel">
                                            <!-- Услуги будут добавляться динамически -->
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Выбор врача -->
                                <Border Style="{StaticResource SectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Выбор врача" 
                                                   FontWeight="Bold" 
                                                   FontSize="18" 
                                                   Foreground="#244484" 
                                                   Margin="0,0,0,15"/>

                                        <StackPanel x:Name="DoctorsStackPanel">
                                            <!-- Врачи будут добавляться динамически -->
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- Правая колонка - дата и подтверждение -->
                            <StackPanel Grid.Column="2">
                                <!-- Выбор даты и времени -->
                                <Border Style="{StaticResource SectionStyle}">
                                    <StackPanel>
                                        <TextBlock Text="Выбор даты и времени" 
                                                   FontWeight="Bold" 
                                                   FontSize="18" 
                                                   Foreground="#244484" 
                                                   Margin="0,0,0,15"/>

                                        <!-- Дата -->
                                        <StackPanel Margin="0,0,0,15">
                                            <TextBlock Text="Дата приема" 
                                                       Foreground="#828CA0" 
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,5"/>
                                            <DatePicker x:Name="AppointmentDatePicker" 
                                                        Style="{StaticResource AppointmentDatePicker}"/>
                                        </StackPanel>

                                        <!-- Время -->
                                        <StackPanel Margin="0,0,0,20">
                                            <TextBlock Text="Время приема" 
                                                       Foreground="#828CA0" 
                                                       FontSize="12"
                                                       FontWeight="SemiBold"
                                                       Margin="0,0,0,5"/>
                                            <ComboBox x:Name="TimeComboBox"
                                                      Style="{StaticResource AppointmentComboBox}"
                                                      SelectedIndex="0">
                                                <ComboBoxItem Content="09:00"/>
                                                <ComboBoxItem Content="10:00"/>
                                                <ComboBoxItem Content="11:00"/>
                                                <ComboBoxItem Content="12:00"/>
                                                <ComboBoxItem Content="14:00"/>
                                                <ComboBoxItem Content="15:00"/>
                                                <ComboBoxItem Content="16:00"/>
                                                <ComboBoxItem Content="17:00"/>
                                            </ComboBox>
                                        </StackPanel>

                                        <!-- Информация о записи -->
                                        <Border Background="#F8FBFF" 
                                                CornerRadius="8" 
                                                BorderBrush="#E1E8FF" 
                                                BorderThickness="1"
                                                Padding="12"
                                                Margin="0,10,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Информация о записи" 
                                                           FontWeight="Bold" 
                                                           FontSize="12" 
                                                           Foreground="#244484" 
                                                           Margin="0,0,0,8"/>

                                                <Grid>
                                                    <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="Auto"/>
                                                    </Grid.RowDefinitions>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock x:Name="SelectedServiceLabel" 
                                                               Grid.Row="0" Grid.Column="0" 
                                                               Text="Услуга:" 
                                                               Foreground="#828CA0" 
                                                               FontSize="11"/>
                                                    <TextBlock x:Name="SelectedServiceText" 
                                                               Grid.Row="0" Grid.Column="1" 
                                                               Text="Не выбрана" 
                                                               FontWeight="SemiBold" 
                                                               FontSize="11" 
                                                               Foreground="#244484"/>

                                                    <TextBlock x:Name="SelectedDoctorLabel" 
                                                               Grid.Row="1" Grid.Column="0" 
                                                               Text="Врач:" 
                                                               Foreground="#828CA0" 
                                                               FontSize="11"
                                                               Margin="0,4,0,0"/>
                                                    <TextBlock x:Name="SelectedDoctorText" 
                                                               Grid.Row="1" Grid.Column="1" 
                                                               Text="Не выбран" 
                                                               FontWeight="SemiBold" 
                                                               FontSize="11" 
                                                               Foreground="#244484"
                                                               Margin="0,4,0,0"/>

                                                    <TextBlock x:Name="SelectedPriceLabel" 
                                                               Grid.Row="2" Grid.Column="0" 
                                                               Text="Стоимость:" 
                                                               Foreground="#828CA0" 
                                                               FontSize="11"
                                                               Margin="0,4,0,0"/>
                                                    <TextBlock x:Name="SelectedPriceText" 
                                                               Grid.Row="2" Grid.Column="1" 
                                                               Text="0 ₽" 
                                                               FontWeight="Bold" 
                                                               FontSize="11" 
                                                               Foreground="#467EEA"
                                                               Margin="0,4,0,0"/>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <!-- Кнопка подтверждения -->
                                <Button Content="Записаться на прием" 
                                        Style="{StaticResource AppointmentButtonStyle}"
                                        Margin="0,28,0,0"
                                        Click="ConfirmAppointmentButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>