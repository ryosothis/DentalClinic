<Page x:Class="DentalClinic.Login"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      Title="Login" 
      Height="Auto"
      MinHeight="600"
      MinWidth="800">

    <Page.Resources>
        <!-- Стиль для текстовых полей -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#244484"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="BorderBrush" Value="#C9DEFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#467EEA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Стиль для кнопки -->
        <Style x:Key="AuthButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#244484"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Padding" Value="20,12"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="12"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A366B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F2444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для ссылки -->
        <Style x:Key="LinkStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#467EEA"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="TextDecorations" Value="Underline"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#244484"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140" MinWidth="120"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель Квио -->
        <StackPanel Grid.Column="0" Background="#244484">
            <StackPanel Orientation="Horizontal" Margin="18,26,0,16" VerticalAlignment="Top">
                <TextBlock Text="Квио" Foreground="White" FontWeight="Bold" FontSize="26"/>
                <Image Source="/logo.png" Width="32" Height="32" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="цифровая стоматология" Foreground="White" 
                       Margin="18,-20,0,36" FontSize="9"/>
            <StackPanel Margin="18,0,0,0">
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="HomePanel_MouseLeftButtonDown">
                    <Image Source="/home.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Главная" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="AboutPanel_MouseLeftButtonDown">
                    <Image Source="/info.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="О клинике" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="ServicesPanel_MouseLeftButtonDown">
                    <Image Source="/services.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Услуги" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="PricePanel_MouseLeftButtonDown">
                    <Image Source="/price.png" Width="20" Height="20" Margin="0,5,10,0"/>
                    <TextBlock Text="Цены" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" Cursor="Hand"
                            MouseLeftButtonDown="ProfilePanel_MouseLeftButtonDown">
                    <Image Source="/user.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Профиль" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="18,20,0,20" VerticalAlignment="Bottom">
                <Image Source="/vk.png" Width="20" Height="20" Margin="0,0,10,0"/>
                <Image Source="/whatsapp.png" Width="20" Height="20" Margin="0,0,10,0"/>
                <Image Source="/tg.png" Width="20" Height="20"/>
            </StackPanel>
        </StackPanel>

        <!-- Основной контент -->
        <Border Grid.Column="1" Background="#F5F6FA">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                <Grid>
                    <!-- Адаптивная форма входа -->
                    <Border Background="White" CornerRadius="20" 
                            VerticalAlignment="Center" HorizontalAlignment="Center"
                            MinWidth="350" MaxWidth="450"
                            Width="400"
                            MinHeight="450" MaxHeight="600"
                            Height="500"
                            BorderBrush="#E1E8FF" BorderThickness="1"
                            Margin="20">
                        <StackPanel Margin="30,40,30,40" VerticalAlignment="Center">
                            <TextBlock Text="Вход в систему" 
                                       FontWeight="Bold" FontSize="26" 
                                       Foreground="#244484" 
                                       HorizontalAlignment="Center" 
                                       Margin="0,0,0,30"
                                       TextWrapping="Wrap"/>

                            <StackPanel Margin="0,0,0,20">
                                <TextBlock Text="Email" 
                                           Foreground="#244484" 
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <TextBox x:Name="EmailTextBox" 
                                         Style="{StaticResource ModernTextBox}"
                                         MinWidth="200"/>
                            </StackPanel>

                            <StackPanel Margin="0,0,0,25">
                                <TextBlock Text="Пароль" 
                                           Foreground="#244484" 
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <PasswordBox x:Name="PasswordBox" 
                                             Background="#FFFFFF"
                                             Foreground="#244484"
                                             FontSize="16"
                                             Padding="16,12"
                                             BorderBrush="#C9DEFF"
                                             BorderThickness="2"
                                             Height="48"
                                             VerticalContentAlignment="Center"
                                             MinWidth="200"/>
                            </StackPanel>

                            <CheckBox x:Name="RememberMeCheckBox" 
                                      Content="Запомнить меня" 
                                      Foreground="#244484"
                                      FontSize="14"
                                      Margin="0,0,0,25"/>

                            <Button x:Name="LoginButton" 
                                    Content="Войти" 
                                    Style="{StaticResource AuthButtonStyle}"
                                    Margin="0,0,0,20"
                                    MinWidth="120"
                                    Click="LoginButton_Click"/>

                            <StackPanel Orientation="Horizontal" 
                                        HorizontalAlignment="Center"
                                        TextBlock.TextAlignment="Center">
                                <TextBlock Text="Нет аккаунта? " 
                                           Foreground="#828CA0"
                                           FontSize="14"/>
                                <TextBlock x:Name="RegisterLink" 
                                           Text="Зарегистрируйтесь" 
                                           Style="{StaticResource LinkStyle}"
                                           Margin="5,0,0,0"
                                           MouseDown="RegisterLink_MouseDown"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>