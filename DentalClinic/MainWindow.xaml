<Page x:Class="DentalClinic.MainWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Title="Квио - цифровая стоматология">

    <Page.Resources>
        <Style TargetType="Button">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}" 
                                CornerRadius="10" 
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.92"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" TargetName="border" Value="0.85"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="15"/>
        </Style>

        <Style x:Key="RoundedTextBox" TargetType="TextBox">
            <Setter Property="Cursor" Value="IBeam"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border" CornerRadius="18" 
                                Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ScrollViewer Margin="0" x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9DEFF"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Padding" Value="10,2"/>
            <Setter Property="FontSize" Value="16"/>
        </Style>

        <!-- Стиль для кликабельных панелей навигации -->
        <Style x:Key="NavPanelStyle" TargetType="StackPanel">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Стиль для карточек услуг -->
        <Style x:Key="ServiceCardStyle" TargetType="Border">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Стиль для результатов поиска -->
        <Style x:Key="SearchResultItemStyle" TargetType="ListBoxItem">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#E1E8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Padding" Value="15,10"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FBFF"/>
                    <Setter Property="BorderBrush" Value="#467EEA"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Сайдбар -->
        <StackPanel Grid.Column="0" Background="#244484" VerticalAlignment="Stretch" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Margin="18,26,0,16" VerticalAlignment="Top">
                <TextBlock Text="Квио" Foreground="White" FontWeight="Bold" FontSize="26"/>
                <Image Source="/logo.png" Width="32" Height="32" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="цифровая стоматология" Foreground="White" Margin="18,-20,0,36" FontSize="9"/>

            <StackPanel Margin="18,0,0,0">
                <StackPanel Style="{StaticResource NavPanelStyle}" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" MouseLeftButtonDown="HomeButton_Click">
                    <Image Source="/home.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Главная" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Style="{StaticResource NavPanelStyle}" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" MouseLeftButtonDown="AboutButton_Click">
                    <Image Source="/info.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="О клинике" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Style="{StaticResource NavPanelStyle}" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" MouseLeftButtonDown="ServicesButton_Click">
                    <Image Source="/services.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Услуги" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Style="{StaticResource NavPanelStyle}" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" MouseLeftButtonDown="PricesButton_Click">
                    <Image Source="/price.png" Width="20" Height="20" Margin="0,5,10,0"/>
                    <TextBlock Text="Цены" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Style="{StaticResource NavPanelStyle}" Orientation="Horizontal" Margin="0,10,0,0" VerticalAlignment="Center" MouseLeftButtonDown="ProfileButton_Click">
                    <Image Source="/user.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Профиль" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="-8,350,0,0" HorizontalAlignment="Left">
                <Image Source="/vk.png" Width="20" Height="20" Margin="30,0,0,0" Cursor="Hand" MouseLeftButtonDown="VkButton_Click"/>
                <Image Source="/whatsapp.png" Width="20" Height="20" Margin="16,0,0,0" Cursor="Hand" MouseLeftButtonDown="WhatsAppButton_Click"/>
                <Image Source="/tg.png" Width="20" Height="20" Margin="16,0,0,0" Cursor="Hand" MouseLeftButtonDown="TelegramButton_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- Основной контент -->
        <StackPanel Grid.Column="1" Background="#F5F6FA" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
            <TextBlock Text="Цифровая точность – здоровая улыбка" HorizontalAlignment="Center" FontWeight="Bold"
                       FontSize="32" Margin="0,36,0,6" Foreground="#244484"/>
            <TextBlock Text="Красивая улыбка – просто" HorizontalAlignment="Center" FontSize="16"
                       Foreground="#96A0B5" Margin="0,0,0,16"/>

            <!-- Поиск с результатами -->
            <Grid Width="730" HorizontalAlignment="Center" Margin="0,0,0,32">
                <Grid.RowDefinitions>
                    <RowDefinition Height="36"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBox x:Name="SearchTextBox"
                         Style="{StaticResource RoundedTextBox}"
                         VerticalContentAlignment="Center"
                         Padding="44,0,40,0"
                         TextChanged="SearchTextBox_TextChanged"/>
                <Image Source="/search.png"
                       Width="20" Height="20"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"
                       Margin="10,0,0,0"
                       IsHitTestVisible="False"/>

                <!-- Результаты поиска -->
                <Border Grid.Row="1" 
                        Background="White" 
                        BorderBrush="#E1E8FF" 
                        BorderThickness="1" 
                        CornerRadius="8"
                        Margin="0,5,0,0"
                        Visibility="Collapsed"
                        x:Name="SearchResultsBorder">
                    <ListBox x:Name="SearchResultsListBox"
                             Background="Transparent"
                             BorderThickness="0"
                             ItemContainerStyle="{StaticResource SearchResultItemStyle}"
                             SelectionChanged="SearchResultsListBox_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" 
                                               FontWeight="SemiBold" 
                                               FontSize="14" 
                                               Foreground="#244484"/>
                                    <TextBlock Text="{Binding Description}" 
                                               FontSize="12" 
                                               Foreground="#828CA0"
                                               TextWrapping="Wrap"
                                               Margin="0,2,0,0"/>
                                    <TextBlock Text="{Binding Price, StringFormat='{}Цена: {0} руб.'}" 
                                               FontSize="12" 
                                               Foreground="#4CAF50"
                                               FontWeight="SemiBold"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Border>
            </Grid>

            <TextBlock Text="Наша клиника" FontWeight="Bold" FontSize="28" HorizontalAlignment="Center" Foreground="#244484" Margin="0,0,0,24"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" >
                <Border Style="{StaticResource ServiceCardStyle}" BorderBrush="#C9DEFF" BorderThickness="2" CornerRadius="22" Width="230" Height="240" Margin="0,0,18,0" MouseLeftButtonDown="BracesCard_Click">
                    <StackPanel>
                        <Image Source="/braces.png" Height="120" Margin="0,10,0,0"/>
                        <TextBlock Text="Исправление прикуса" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,14,0,2"/>
                        <Button Content="Подробнее" HorizontalAlignment="Center" Margin="0,10,0,0" Background="#C9DEFF" Foreground="#244484" Padding="18,2" BorderBrush="#C9DEFF" Click="BracesDetails_Click"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ServiceCardStyle}" BorderBrush="#C9DEFF" BorderThickness="2" CornerRadius="22" Width="230" Height="240" Margin="0,0,18,0" MouseLeftButtonDown="DiagnosticsCard_Click">
                    <StackPanel>
                        <Image Source="/diagnostics.png" Height="120" Margin="0,10,0,0"/>
                        <TextBlock Text="Диагностика" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,14,0,2"/>
                        <Button Content="Подробнее" HorizontalAlignment="Center" Margin="0,10,0,0" Background="#C9DEFF" Foreground="#244484" Padding="18,2" BorderBrush="#C9DEFF" Click="DiagnosticsDetails_Click"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ServiceCardStyle}" BorderBrush="#C9DEFF" BorderThickness="2" CornerRadius="22" Width="230" Height="240" Margin="0,0,18,0" MouseLeftButtonDown="TreatmentCard_Click">
                    <StackPanel>
                        <Image Source="/treatment.png" Height="120" Margin="0,10,0,0"/>
                        <TextBlock Text="Лечение зубов" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,14,0,2"/>
                        <Button Content="Подробнее" HorizontalAlignment="Center" Margin="0,10,0,0" Background="#C9DEFF" Foreground="#244484" Padding="18,2" BorderBrush="#C9DEFF" Click="TreatmentDetails_Click"/>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,28,0,0">
                <Button Background="#EDF5FF" Foreground="#244484" Padding="22,4" BorderBrush="#EDF5FF" Margin="0,0,10,0" Click="ProstheticsButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Протезирование" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Image Source="/protez.png" Width="18" Height="18" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Background="#EDF5FF" Foreground="#244484" Padding="22,4" BorderBrush="#EDF5FF" Margin="0,0,10,0" Click="ImplantationButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Имплантация" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Image Source="/implant.png" Width="18" Height="18" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Background="#EDF5FF" Foreground="#244484" Padding="22,4" BorderBrush="#EDF5FF" Margin="0,0,10,0" Click="WhiteningButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Отбеливание" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Image Source="/white.png" Width="18" Height="18" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>

                <Button Background="#EDF5FF" Foreground="#244484" Padding="22,4" BorderBrush="#EDF5FF" Click="ChildrenButton_Click">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="Для детей" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <Image Source="/child.png" Width="18" Height="18" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,36,0,0">
                <Button Content="Записаться на прием" Background="#C9FFD9" Foreground="#2AA854" Padding="28,8" FontWeight="Bold" BorderBrush="#C9FFD9" Click="MakeAppointmentButton_Click"/>
                <Button Content="Наш адрес" Background="#C9DEFF" Foreground="#244484" Padding="28,8" FontWeight="Bold" BorderBrush="#C9DEFF" Margin="14,0,0,0" Click="AddressButton_Click"/>
                <Button Content="Яндекс Карты" Background="White" Foreground="#E93B26" Padding="20,8" FontWeight="Bold" BorderBrush="White" Margin="8,0,0,0" Click="MapsButton_Click"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>