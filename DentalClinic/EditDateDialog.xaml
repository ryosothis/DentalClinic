<Window x:Class="DentalClinic.EditDateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выбор даты" 
        Height="350" 
        Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent">

    <Window.Resources>
        <!-- Стиль для DatePicker с закруглением -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="Foreground" Value="#244484"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="DatePicker">
                        <Border x:Name="border" 
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="2"
                                CornerRadius="8"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <DatePickerTextBox x:Name="PART_TextBox" 
                                                  Grid.Column="0" 
                                                  Background="Transparent"
                                                  BorderThickness="0"
                                                  Padding="12,10"
                                                  VerticalContentAlignment="Center"/>

                                <Button x:Name="PART_Button" 
                                        Grid.Column="1" 
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Width="30"
                                        Content="📅"
                                        FontSize="14"
                                        Cursor="Hand"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsFocused" Value="True">
                                <Setter TargetName="border" Property="BorderBrush" Value="#467EEA"/>
                                <Setter TargetName="border" Property="Background" Value="#F8FBFF"/>
                            </Trigger>
                            <Trigger Property="IsFocused" Value="False">
                                <Setter TargetName="border" Property="BorderBrush" Value="#E1E8FF"/>
                                <Setter TargetName="border" Property="Background" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DialogButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#244484"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" 
                                CornerRadius="8"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A366B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F2444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="CancelButtonStyle" TargetType="Button" BasedOn="{StaticResource DialogButtonStyle}">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="#244484"/>
            <Setter Property="BorderBrush" Value="#E1E8FF"/>
            <Setter Property="BorderThickness" Value="2"/>
        </Style>

        <!-- Эффект тени -->
        <DropShadowEffect x:Key="ShadowEffect" 
                          BlurRadius="20" 
                          ShadowDepth="0" 
                          Color="#40000000" 
                          Opacity="0.3"/>
    </Window.Resources>

    <!-- Затемнение фона -->
    <Border Background="#80000000" MouseDown="Background_MouseDown">
        <!-- Основное окно -->
        <Border Background="White" 
                CornerRadius="20"
                Width="380"
                Height="320"
                VerticalAlignment="Center"
                HorizontalAlignment="Center"
                BorderBrush="#E1E8FF"
                BorderThickness="1"
                Effect="{StaticResource ShadowEffect}">

            <Grid>
                <!-- Заголовок -->
                <Border Background="#244484" 
                        CornerRadius="20,20,0,0"
                        Height="30"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="TitleText" 
                               Text="Выбор даты" 
                               Foreground="White" 
                               FontSize="18" 
                               FontWeight="Bold"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <!-- Кнопка закрытия -->
                <Button x:Name="CloseButton"
                        Content="×"
                        FontSize="20"
                        FontWeight="Bold"
                        Foreground="White"
                        Background="Transparent"
                        BorderThickness="0"
                        Width="30"
                        Height="30"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,0,15,0"
                        Click="CloseButton_Click"
                        Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" 
                                    CornerRadius="15"
                                    Background="{TemplateBinding Background}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#FFFFFF40"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <!-- Содержимое -->
                <StackPanel Margin="30" VerticalAlignment="Center">

                    <!-- Подсказка -->
                    <TextBlock Text="Выберите новую дату" 
                               Foreground="#828CA0" 
                               FontSize="14"
                               TextWrapping="Wrap"
                               Margin="0,0,0,20"
                               HorizontalAlignment="Center"
                               TextAlignment="Center"/>

                    <!-- Поле выбора даты -->
                    <DatePicker x:Name="DatePicker" 
                                Style="{StaticResource ModernDatePicker}"
                                FontSize="14"
                                Margin="0,0,0,30"
                                HorizontalAlignment="Stretch"/>

                    <!-- Кнопки -->
                    <StackPanel Orientation="Horizontal" 
                                HorizontalAlignment="Center"
                                Margin="0,10,0,0">
                        <Button Content="Отмена" 
                                Style="{StaticResource CancelButtonStyle}"
                                Width="120"
                                Click="CancelButton_Click"/>

                        <Button Content="Сохранить" 
                                Style="{StaticResource DialogButtonStyle}"
                                Width="120"
                                Margin="15,0,0,0"
                                Click="SaveButton_Click"/>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>
    </Border>
</Window>