<Page x:Class="DentalClinic.AdminDoctors"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      mc:Ignorable="d" 
      Title="Admin Doctors" 
      Height="Auto" 
      Width="Auto"
      MinHeight="600"
      MinWidth="1000">

    <Page.Resources>
        <!-- Стиль для кнопок админ-панели -->
        <Style x:Key="AdminButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#244484"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="border" CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#1A366B"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="#0F2444"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для таблицы -->
        <Style x:Key="DataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#E1E8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowBackground" Value="#FFFFFF"/>
            <Setter Property="AlternatingRowBackground" Value="#F8FBFF"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E1E8FF"/>
            <Setter Property="VerticalGridLinesBrush" Value="#E1E8FF"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="MinHeight" Value="300"/>
            <Setter Property="HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
        </Style>

        <!-- Стиль для заголовков таблицы -->
        <Style x:Key="DataGridHeaderStyle" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#244484"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
        </Style>

        <!-- Стиль для секций -->
        <Style x:Key="SectionStyle" TargetType="Border">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="BorderBrush" Value="#E1E8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#B8BFD9" BlurRadius="12" ShadowDepth="3" Opacity="0.08"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль для панелей навигации -->
        <Style x:Key="NavPanelStyle" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal"/>
            <Setter Property="Margin" Value="0,10,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Стиль для текстовых полей -->
        <Style x:Key="AdminTextBox" TargetType="TextBox">
            <Setter Property="Background" Value="#F8FBFF"/>
            <Setter Property="Foreground" Value="#244484"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="BorderBrush" Value="#E1E8FF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#467EEA"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="140"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель Квио -->
        <StackPanel Grid.Column="0" Background="#244484">
            <StackPanel Orientation="Horizontal" Margin="18,26,0,16" VerticalAlignment="Top">
                <TextBlock Text="Квио" Foreground="White" FontWeight="Bold" FontSize="26"/>
                <Image Source="/logo.png" Width="32" Height="32" Margin="10,0,0,0"/>
            </StackPanel>
            <TextBlock Text="цифровая стоматология" Foreground="White" 
                       Margin="18,-20,0,36" FontSize="9"/>
            <StackPanel Margin="18,0,0,0">
                <!-- Главная -->
                <StackPanel x:Name="HomePanel" Style="{StaticResource NavPanelStyle}"
                            MouseLeftButtonDown="HomePanel_MouseLeftButtonDown">
                    <Image Source="/home.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Главная" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- О клинике -->
                <StackPanel x:Name="AboutPanel" Style="{StaticResource NavPanelStyle}"
                            MouseLeftButtonDown="AboutPanel_MouseLeftButtonDown">
                    <Image Source="/info.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="О клинике" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Услуги -->
                <StackPanel x:Name="ServicesPanel" Style="{StaticResource NavPanelStyle}"
                            MouseLeftButtonDown="ServicesPanel_MouseLeftButtonDown">
                    <Image Source="/services.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Услуги" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Цены -->
                <StackPanel x:Name="PricePanel" Style="{StaticResource NavPanelStyle}"
                            MouseLeftButtonDown="PricePanel_MouseLeftButtonDown">
                    <Image Source="/price.png" Width="20" Height="20" Margin="0,5,10,0"/>
                    <TextBlock Text="Цены" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Профиль -->
                <StackPanel x:Name="ProfilePanel" Style="{StaticResource NavPanelStyle}"
                            MouseLeftButtonDown="ProfilePanel_MouseLeftButtonDown">
                    <Image Source="/user.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Профиль" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>

                <!-- Админ -->
                <StackPanel x:Name="AdminPanel" Style="{StaticResource NavPanelStyle}"
                            MouseLeftButtonDown="AdminPanel_MouseLeftButtonDown">
                    <Image Source="/admin.png" Width="20" Height="20" Margin="0,0,10,0"/>
                    <TextBlock Text="Админ" Foreground="White" FontSize="16" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="18,20,0,20" VerticalAlignment="Bottom">
                <Image Source="/vk.png" Width="20" Height="20" Margin="0,0,10,0"/>
                <Image Source="/whatsapp.png" Width="20" Height="20" Margin="0,0,10,0"/>
                <Image Source="/tg.png" Width="20" Height="20"/>
            </StackPanel>
        </StackPanel>

        <!-- Основной контент -->
        <Border Grid.Column="1" Background="#F5F6FA">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="20" MinWidth="1000">
                    <!-- Заголовок -->
                    <TextBlock Text="Управление врачами" 
                               FontWeight="Bold" FontSize="28" 
                               Foreground="#244484" 
                               Margin="0,0,0,20"/>

                    <!-- Панель действий -->
                    <Border Style="{StaticResource SectionStyle}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBlock Text="Действия" 
                                           FontWeight="Bold" FontSize="18" 
                                           Foreground="#244484"/>
                                <Button Content="Добавить врача" 
                                        Style="{StaticResource AdminButtonStyle}"
                                        Margin="15,0,0,0"
                                        Background="#4CAF50"
                                        Foreground="White"
                                        Padding="12,8"
                                        Click="AddDoctorButton_Click"/>
                                <Button Content="Обновить" 
                                        Style="{StaticResource AdminButtonStyle}"
                                        Margin="10,0,0,0"
                                        Background="#E1E8FF"
                                        Foreground="#244484"
                                        Padding="12,8"
                                        Click="RefreshButton_Click" Cursor="Hand"/>
                            </StackPanel>

                            <!-- Поиск -->
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                <TextBox x:Name="SearchTextBox" 
                                         Style="{StaticResource AdminTextBox}"
                                         Width="300"
                                         Margin="0,0,10,0"
                                         TextChanged="SearchTextBox_TextChanged"/>
                            </StackPanel>

                            <!-- Таблица врачей -->
                            <DataGrid x:Name="DoctorsDataGrid" 
                                      Style="{StaticResource DataGridStyle}"
                                      AutoGenerateColumns="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="ID" Width="Auto" HeaderStyle="{StaticResource DataGridHeaderStyle}" Binding="{Binding Id}" IsReadOnly="True" MinWidth="60"/>
                                    <DataGridTextColumn Header="ФИО" Width="*" HeaderStyle="{StaticResource DataGridHeaderStyle}" Binding="{Binding FullName}" MinWidth="180"/>
                                    <DataGridTextColumn Header="Специализация" Width="*" HeaderStyle="{StaticResource DataGridHeaderStyle}" Binding="{Binding Specialization}" MinWidth="150"/>
                                    <DataGridTextColumn Header="Опыт" Width="Auto" HeaderStyle="{StaticResource DataGridHeaderStyle}" Binding="{Binding ExperienceText}" MinWidth="100"/>
                                    <DataGridTextColumn Header="Образование" Width="*" HeaderStyle="{StaticResource DataGridHeaderStyle}" Binding="{Binding Education}" MinWidth="200"/>
                                    <DataGridTemplateColumn Header="Действия" Width="Auto" HeaderStyle="{StaticResource DataGridHeaderStyle}" IsReadOnly="True" MinWidth="130">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Button Content="✏️" 
                                                            Background="Transparent" 
                                                            BorderThickness="0"
                                                            Foreground="#467EEA"
                                                            FontSize="12"
                                                            Padding="8,5"
                                                            Click="EditDoctorButton_Click"
                                                            Tag="{Binding Id}"
                                                            ToolTip="Редактировать"
                                                            Cursor="Hand"/>
                                                    <Button Content="❌" 
                                                            Background="Transparent" 
                                                            BorderThickness="0"
                                                            Foreground="#FF6B6B"
                                                            FontSize="12"
                                                            Padding="8,5"
                                                            Click="DeleteDoctorButton_Click"
                                                            Tag="{Binding Id}"
                                                            ToolTip="Удалить"
                                                            Cursor="Hand"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>